# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Postgres (docker-compose local usa porta 5433)
DATABASE_URL=postgresql://guerra:guerra@localhost:5433/guerraacervo

# Redis (docker-compose local usa porta 6380)
REDIS_URL=redis://:guerra@localhost:6380

# Auth (trocar em produção)
AUTH_SECRET=dev-change-me-use-openssl-rand-hex-32

# Stripe (plataforma — assinatura SaaS; preencher depois)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# IA via OpenRouter (foto da capa + texto + web grounding)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_FALLBACKS=openai/gpt-4o-mini,openai/gpt-4o
OPENROUTER_WEB_SEARCH=true
# Legado (só se não houver OPENROUTER_API_KEY)
OPENAI_API_KEY=
