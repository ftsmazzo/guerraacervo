# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Postgres (docker-compose local usa porta 5433)
DATABASE_URL=postgresql://guerra:guerra@localhost:5433/guerraacervo

# Redis (docker-compose local usa porta 6380)
REDIS_URL=redis://:guerra@localhost:6380

# Auth (trocar em produção)
AUTH_SECRET=dev-change-me-use-openssl-rand-hex-32

# Stripe (plataforma — assinatura SaaS Negócio)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_MASTER=

# E-mail onboarding (Resend; sem chave = só log)
RESEND_API_KEY=
EMAIL_FROM=GuerraAcervo <onboarding@resend.dev>

# WhatsApp OTP / boas-vindas (instância Evolution da plataforma)
SIGNUP_WHATSAPP_INSTANCE=ga-sebo-demo
# SIGNUP_OTP_DEBUG=1

# Web Push (painel — alertas de reserva no celular)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@guerraacervo.local

# Google Books (recomendado) — sem chave a cota pública estoura e a ficha fica instável
GOOGLE_BOOKS_API_KEY=

# IA via OpenRouter (foto da capa + texto + web grounding)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_FALLBACKS=openai/gpt-4o-mini,openai/gpt-4o
OPENROUTER_WEB_SEARCH=true
# Legado (só se não houver OPENROUTER_API_KEY)
OPENAI_API_KEY=

# WhatsApp / Evolution API
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
